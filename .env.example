ECHO_TARGETS=all
ANNOUNCEMENT=Es hat an der Haustür geklingelt.
DEBOUNCE_MS=5000
QUEUE_SIZE=4
MAX_EVENT_AGE_MS=15000
ALEXA_TIMEOUT_MS=5000
# Optional: nach npm run ntfy:setup aktivieren
# ECHO_TARGETS=all wählt alle aktuell online gemeldeten einzelnen Echos.
# NTFY_URL=http://ntfy:8080
# NTFY_TOPIC=haustuer
# NTFY_MESSAGE=Es hat an der Haustür geklingelt.
# NTFY_TIMEOUT_MS=3000

# Separater eigener Alexa-Skill (Ansage bleibt Standard):
ALEXA_OUTPUT=speak
# ALEXA_SKILL_AUDIO_FILE=/audio/ring.mp3
# ALEXA_SKILL_BASE_URL=https://doorbird.example.com
# ALEXA_SKILL_ID=amzn1.ask.skill.UUID-AUS-DER-DEVELOPER-CONSOLE
# ALEXA_SKILL_AUDIO_ORDER=before
# ALEXA_SKILL_LAUNCH=id
# ALEXA_SKILL_INVOCATION=dungeon klingel
# ALEXA_SKILL_USER_ID=amzn1.ask.account.DEIN-SKILL-BENUTZER
